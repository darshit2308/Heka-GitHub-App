# GitHub App identity
APP_ID=123456
# PEM of the GitHub App private key. Set this in the environment.
# Do not commit a key file, and do not point PRIVATE_KEY_PATH inside this repository.
# PRIVATE_KEY=
WEBHOOK_SECRET=replace-with-the-github-app-webhook-secret

# Run Probot separately from heka-identity-service, which defaults to port 3000.
PORT=3001
WEBHOOK_PATH=/api/github/webhooks

# Heka identity service endpoint consumed by the GitHub App.
HEKA_SERVICE_URL=http://localhost:3000
